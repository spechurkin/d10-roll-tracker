<div class="rollcard cpr-roll-tracker-chat-card {{themeClass}}">
  <div class="rollcard-top">
    <div class="cpr-block chat-rollTitle-stat">
      <div class="cpr-roll-tracker-chat-title text-center text-padding-top text-normal text-semi">
        <i class="fas fa-chart-simple" aria-hidden="true"></i>
        <span>{{localize "D10RollTracker.ComparisonTitle"}}</span>
      </div>
      <div class="rollcard-subtitle">
        <div class="rollcard-subtitle-center text-small">{{viewLabel}}</div>
      </div>
    </div>
  </div>
  <div class="rollcard-bottom">
    <div class="cpr-block">
      <table class="cpr-roll-tracker-comparison-table">
        <thead>
          <tr>
            <th>{{localize "D10RollTracker.User"}}</th>
            <th>{{localize "D10RollTracker.Total"}}</th>
            <th>{{localize "D10RollTracker.Ones"}}</th>
            <th>{{localize "D10RollTracker.Tens"}}</th>
            <th>{{localize "D10RollTracker.Median"}}</th>
            <th>{{localize "D10RollTracker.Average"}}</th>
          </tr>
        </thead>
        <tbody>
          {{#each users}}
            <tr>
              <td>{{name}}</td>
              <td>{{total}}</td>
              <td>{{ones}}</td>
              <td>{{tens}}</td>
              <td>{{median}}</td>
              <td>{{average}}</td>
            </tr>
          {{/each}}
        </tbody>
      </table>
      <ul class="cpr-roll-tracker-highlights">
        <li><strong>{{localize "D10RollTracker.HighestAverage"}}:</strong> {{highestAverage.names}} — {{highestAverage.value}}</li>
        <li><strong>{{localize "D10RollTracker.LowestAverage"}}:</strong> {{lowestAverage.names}} — {{lowestAverage.value}}</li>
        <li><strong>{{localize "D10RollTracker.MostOnes"}}:</strong> {{mostOnes.names}} — {{mostOnes.value}}</li>
        <li><strong>{{localize "D10RollTracker.MostTens"}}:</strong> {{mostTens.names}} — {{mostTens.value}}</li>
      </ul>
    </div>
  </div>
</div>
